# Password for the admin section at /admin (accounts, results, VIP, comments).
# Learners sign in with a name only, so this is the only password in the app.
ADMIN_PASSWORD=change-me-to-a-long-password

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Neon PostgreSQL connection string. Required on Vercel.
# Leave empty for local development: an embedded database is created in ./.pglite
DATABASE_URL=
